{
  "name": "my-pi-package",
  "version": "0.1.0",
  "description": "Personal Pi package for a reproducible extension, prompt, and theme setup",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions",
    "prompts",
    "themes",
    "config",
    "install.sh",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run && npm run test:memory",
    "test:memory": "node --test test/*.node-test.ts",
    "pack:check": "vitest run test/manifest.test.ts test/pack.test.ts test/source-boundary.test.ts test/install.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/ui/index.ts",
      "./extensions/chat-mode.ts",
      "./extensions/memory/index.ts",
      "./extensions/openai-usage.ts"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@types/node": "22.15.3",
    "typebox": "1.1.38",
    "typescript": "5.8.3",
    "vitest": "3.1.3"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "personal"
  ]
}
